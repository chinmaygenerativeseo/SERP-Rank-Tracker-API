# Database Configuration
DB_SERVER=your-server-name.database.windows.net
DB_PORT=1433
DB_DATABASE=your-database-name

# Authentication (Windows Authentication or SQL Server Authentication)
# Set to 'true' to use Windows/Integrated Authentication
DB_USE_WINDOWS_AUTH=false

# SQL Server Authentication credentials (ignored if DB_USE_WINDOWS_AUTH=true)
DB_USERNAME=your-username
DB_PASSWORD=your-password

# ODBC Driver Options
# Supported values: "ODBC Driver 18 for SQL Server", "ODBC Driver 17 for SQL Server", etc.
# If left blank, connection.py will automatically detect the best available driver.
DB_DRIVER=

# Security options
# ODBC 18 requires TrustServerCertificate=yes by default for self-signed certificates.
DB_TRUST_SERVER_CERTIFICATE=yes
DB_ENCRYPT=yes
